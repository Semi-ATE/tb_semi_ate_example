{
    "init": {
        "tester":{
                "smu" : [
              		{"voltage": 0},
              		{"i_clamp": 0.2}
          		],
          		"matrix": [
          			["load_connectionTable()", "$HARNESS/matrix_qdbmessplatz.setup"]
          		],
          		"loadmat": [
          			["loadNames", {"NoLoad": "noload", "Open": "open", "PullUp_100k": "load=1", "PullDown_10k": "load=2", "PullDown_100k": "load=3", "Empty4": "load=4"}]
          		],
          		"interface": {
              		"myclass": {
              			"HALAPBBoard": [
              				{"biph.addr_bits": 5},
              				{"biph.data_bits": 16},
              			    {"bitTime": 1000},
              				{"mode": "A"},
              				{"pullup": 1},
              				{"biph.delay": 0.1},
          				    {"parent.regs.use": "biph"}
          					],
              			"STIBoard": [
              				{"mode": "A"},
              				{"clock_off()": "None"},
              				{"vsup": 6},
              				{"write()": "stisetcmd 27 1"},
              				{"clock_MHz": 1.0},
              				{"clock_internal()": "None"},
              				{"sti.delay": 0.01},
              				{"parent.regs.use": "sti"}
          					]
              			}
          			}
            },
        "regs": [
            {"banksize": 32}
            ]
		},
	"memorymap": {
		"ROM":  {"sti": "0x30:0x3f", "biph": "0x30:0x3f"}
	    },
    "regs": {
        "nodump": ["RAM_TEMP_ADJ", "RAM_MIC_OFF", "RAM_MIC_GAIN", "RAM_CUST_OFF", "RAM_CUST_GAIN", "RAM_MIC_COMP", "RAM_CUST_COMP", "RAM_ASIN", "RAM_SETPT", "RAM_GAINOFF", "RAM_TMP1", "RAM_TMP2", "RAM_TMP3", "RAM_TMP4", "RAM_TMP5", "RAM_TMP6","NVPROGM", "DIAGNOSIS", "TEST0", "TEST1", "TEST2", "TEST3", "TEST4", "TEST5", "TEST6", "TEST7", "TEST8", "TEMP", "CFX", "DAC","UNLOCK_2", "UNLOCK_1", "UNLOCK_0"],
		"unlock": [["UNLOCK_0", 17821], ["UNLOCK_1", 60577], ["UNLOCK_2", 62788]],
		"progm":  "NVPROGM"
        },
	"macro": {
		"poweron": ["tester.interface.off()","tester.interface.on()"],
		"hwid":    ["regs.HW_ID_BASE.read()"],
		"micid":   ["regs.EE_MIC_ID2.read()","regs.EE_MIC_ID1.read()", "tptasks.micid('hal')"],
		"biphreset": ["regs.use = 'biph'", "tester.interface.biph.reset()", "tester.interface.clock_MHz = 4.0", "tester.interface.clock_off()"]
		},
	"tests": {
		"VsupDiag": {
			"init":     [{"loadmat.load()": "NoLoad"}],
			"VSupRamp": "3:0.01:4.5 5.5:0.01:7 8.4:0.01:10.1 10.1:-0.01:8.4 7:-0.01:5.5 4.5:-0.01:3",
			"TRamp":    "TempCorse"
			},
		"NVRAM_write": {
			"Biphase": [["NV_CUST_SETUP", "0x3090"], ["NV_MIC_SETUP_1", "0xcd80"], ["NV_MIC_SETUP_2", "0x010"]],
			"Burnin":  [["NV_CUST_SETUP", "0x2472"], ["NV_MIC_SETUP_1", "0xcd80"], ["NV_MIC_SETUP_2", "0x010"]],
			"STI":     [["NV_CUST_SETUP", "0x200e"], ["NV_MIC_SETUP_1", "0x0100"], ["NV_MIC_SETUP_2", "0x000"]],
			"BiTest":  [["NV_CUST_SETUP", "0x200e"], ["NV_MIC_SETUP_1", "0x8980"], ["NV_MIC_SETUP_2", "0x0010"]],
			"TRIM":    ["NV_TRIM", "0x2020"]
			},
		"Regfile": {
			"TESTMODE": [["NV_MIC_SETUP_1", "0x8d80"]],
			"STOP": ["regs.TEST1.write(0x001a)"]
			}
		}
}